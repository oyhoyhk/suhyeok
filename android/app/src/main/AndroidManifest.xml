<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Installs updates downloaded from the Mac (Android asks the owner to allow this once). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Agent notifications from a background service that asks the Mac for state. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- The system speech recognizer (dictation) and text-to-speech engines, visible on Android 11+. -->
  <queries>
    <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
  </queries>
  <application
      android:label="수혁"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/Theme.Suhyeok"
      android:allowBackup="false">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTop"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service android:name=".NotifyService" android:exported="false" android:foregroundServiceType="dataSync" />
    <!-- Hands the downloaded update to the system installer. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
    </provider>
    <!-- Portrait QR scanner (zxing-android-embedded defaults to landscape). -->
    <activity
        android:name="com.journeyapps.barcodescanner.CaptureActivity"
        android:screenOrientation="fullSensor"
        tools:replace="screenOrientation"
        xmlns:tools="http://schemas.android.com/tools" />
  </application>
</manifest>
