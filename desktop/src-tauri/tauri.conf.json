{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suhyeok",
  "version": "0.2.5",
  "identifier": "com.pickuma.suhyeok.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/suhyeok-server"
    ],
    "resources": {
      "art/": "art/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
