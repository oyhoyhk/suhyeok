{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suhyeok",
  "version": "0.2.5",
  "identifier": "com.pickuma.suhyeok.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      { "label": "main", "title": "수혁", "url": "index.html", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Korean", "English"] } }
  }
}
